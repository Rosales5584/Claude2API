# ── Server ───────────────────────────────────────────────────────────────────
# PORT=8080

# ── Mode ─────────────────────────────────────────────────────────────────────
# Separate multiple keys with commas.
# CLAUDE_SESSION_KEYS=sk-ant-sid01-xxx,sk-ant-sid01-yyy

# ── Residential Proxy (leave empty to connect directly) ──────────────────────
PROXY_HOST=
PROXY_PORT=3010
PROXY_USER=
PROXY_PASS=
PROXY_REGION=US

# ── Admin Dashboard ───────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=change_me_please     # ← REQUIRED: change before going live
SESSION_SECRET=change_me_session_secret

# ── Rate Limiting ─────────────────────────────────────────────────────────────
CLAUDE_DAILY_LIMIT=0    # 0 = unlimited
MAX_RETRIES=3
COOLDOWN_MINUTES=5

# ── API Key Protection (optional) ─────────────────────────────────────────────
# Uncomment and set to require auth header on /v1/messages
# CLAUDE_API_KEY=sk-your-api-key

# ── Real Upstream Backend (optional) ──────────────────────────────────────────
# Set this to proxy /v1/messages to a real Anthropic-compatible backend.
# Example: https://api.anthropic.com/v1/messages
# UPSTREAM_MESSAGES_URL=
# UPSTREAM_API_KEY=
# UPSTREAM_AUTH_HEADER=x-api-key
# UPSTREAM_ANTHROPIC_VERSION=2023-06-01
